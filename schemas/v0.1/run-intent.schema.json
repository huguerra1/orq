{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orq.local/schemas/v0.1/run-intent.schema.json",
  "title": "ORQ RunIntent v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "project_id",
    "objective",
    "requested_by",
    "experiment_metadata",
    "created_at",
    "idempotency_key",
    "record_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "objective": {
      "$ref": "common.schema.json#/$defs/nonEmptyText",
      "maxLength": 4096
    },
    "requested_by": {
      "type": "object",
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "automation"
          ]
        },
        "ref": {
          "$ref": "common.schema.json#/$defs/identifier"
        }
      },
      "additionalProperties": false
    },
    "experiment_metadata": {
      "$ref": "#/$defs/experimentMetadata"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/utcTimestamp"
    },
    "idempotency_key": {
      "$ref": "common.schema.json#/$defs/nonEmptyText",
      "maxLength": 4096
    },
    "record_hash": {
      "$ref": "common.schema.json#/$defs/digest"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "experimentMetadata": {
      "type": "object",
      "required": [],
      "properties": {
        "group": {
          "$ref": "common.schema.json#/$defs/nonEmptyText",
          "maxLength": 4096
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/nonEmptyText",
            "maxLength": 4096
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
