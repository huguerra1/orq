{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orq.local/schemas/v0.1/workflow.schema.json",
  "title": "ORQ WorkflowSpec v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_id",
    "version",
    "project_id",
    "objective",
    "requirements",
    "external_inputs",
    "tasks",
    "requirement_coverage",
    "outputs",
    "evaluation_criteria",
    "execution_policy_ref",
    "constraints"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "workflow_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "version": {"$ref": "common.schema.json#/$defs/nonEmptyText"},
    "project_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "objective": {"$ref": "common.schema.json#/$defs/nonEmptyText"},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "common.schema.json#/$defs/requirement"},
      "contains": {
        "type": "object",
        "properties": {"required": {"const": true}},
        "required": ["required"]
      }
    },
    "external_inputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/externalInput"}
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "task.schema.json"}
    },
    "requirement_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/requirementCoverage"}
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/workflowOutput"}
    },
    "evaluation_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/workflowCriterion"},
      "contains": {
        "type": "object",
        "properties": {"required": {"const": true}},
        "required": ["required"]
      }
    },
    "execution_policy_ref": {"$ref": "common.schema.json#/$defs/versionedRef"},
    "constraints": {"$ref": "#/$defs/workflowConstraints"}
  },
  "$defs": {
    "externalInput": {
      "type": "object",
      "required": ["input_id", "artifact_type", "description", "content_contract_ref"],
      "properties": {
        "input_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "artifact_type": {"$ref": "common.schema.json#/$defs/identifier"},
        "description": {"$ref": "common.schema.json#/$defs/nonEmptyText"},
        "content_contract_ref": {
          "oneOf": [
            {"$ref": "common.schema.json#/$defs/versionedRef"},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": false
    },
    "requirementCoverage": {
      "type": "object",
      "required": ["workflow_requirement_id", "task_id", "task_requirement_id"],
      "properties": {
        "workflow_requirement_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "task_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "task_requirement_id": {"$ref": "common.schema.json#/$defs/identifier"}
      },
      "additionalProperties": false
    },
    "workflowOutput": {
      "type": "object",
      "required": ["output_id", "artifact_type", "source_task_id", "source_output_id"],
      "properties": {
        "output_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "artifact_type": {"$ref": "common.schema.json#/$defs/identifier"},
        "source_task_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "source_output_id": {"$ref": "common.schema.json#/$defs/identifier"}
      },
      "additionalProperties": false
    },
    "workflowCriterion": {
      "type": "object",
      "required": ["criterion_id", "workflow_requirement_ids", "output_ids", "method", "pass_rule", "required", "verifier_ref"],
      "properties": {
        "criterion_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "workflow_requirement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "common.schema.json#/$defs/identifier"}
        },
        "output_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "common.schema.json#/$defs/identifier"}
        },
        "method": {"$ref": "common.schema.json#/$defs/identifier"},
        "pass_rule": {"type": "object", "minProperties": 1},
        "required": {"type": "boolean"},
        "verifier_ref": {
          "oneOf": [
            {"$ref": "common.schema.json#/$defs/versionedRef"},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": false
    },
    "workflowConstraints": {
      "type": "object",
      "properties": {
        "max_concurrency": {"type": "integer", "minimum": 1},
        "max_run_duration_ms": {"type": "integer", "minimum": 1},
        "max_attempts": {"type": "integer", "minimum": 1},
        "attempt_timeout_ms": {"type": "integer", "minimum": 1},
        "max_evaluations_per_attempt": {"type": "integer", "minimum": 1},
        "evaluation_timeout_ms": {"type": "integer", "minimum": 1},
        "reconciliation_timeout_ms": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
